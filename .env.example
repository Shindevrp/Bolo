# Bolo configuration
# Copy to .env and adjust values

# LLM (vLLM / OpenAI-compatible API)
BOLO_LLM_URL=http://localhost:8000/v1
BOLO_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
BOLO_LLM_API_KEY=EMPTY

# STT (faster-whisper)
BOLO_STT_MODEL=base
BOLO_STT_DEVICE=cpu
BOLO_STT_COMPUTE=int8

# TTS (Piper)
BOLO_TTS_MODEL=/usr/share/piper/voices/en_US-lessac-medium.onnx

# VAD (Silero)
BOLO_VAD_THRESHOLD=0.5

# System-1 decision layer (Laya)
BOLO_LAYA_MODEL=convaiinnovations/laya
BOLO_LAYA_DEVICE=
BOLO_LAYA_ENABLED=1
BOLO_LAYA_CONF_THRESHOLD=0.5
# Phase 2: let confident Laya answers drive intent/complexity/routing.
# Off by default (base checkpoints ship over-confident temperatures);
# enable after shadow-mode agreement data justifies it.
BOLO_LAYA_PHASE2=0
# Phase 3: let confident cadence-1 Laya answers shorten endpointing and steer
# barge verdicts (always inside the deterministic safety floor). Same opt-in.
BOLO_LAYA_PHASE3=0
# Phase 4: cadence-1 "utterance complete" endpoint authority on its own --
# speculative early turn-start during the silence wait without Phase-3's barge
# enforcement. Same safety floor, same opt-in.
BOLO_LAYA_PHASE4=0
# Phase 5: complexity-routing gate -- bare acknowledgments ("sounds good")
# answered deterministically instead of the LLM when Laya confidently marks
# them trivial. Same safety floor, same opt-in.
BOLO_LAYA_PHASE5=0
# Step 2: disk-backed shadow log -- Laya-vs-legacy rows (with self-labels
# where they agree) appended as JSONL so they survive restarts and can be
# exported into fine-tuning data with `bolo-bench laya-export`. Empty = off.
BOLO_LAYA_SHADOW_LOG=~/.bolo/shadow/rows.jsonl

# Escalation tier (Phase-2). Empty URL = escalate votes fall back to primary.
BOLO_LLM_FALLBACK_URL=
BOLO_LLM_FALLBACK_MODEL=
BOLO_LLM_FALLBACK_API_KEY=EMPTY

# SerpApi (https://serpapi.com/manage-api-key) — free tier: 250 searches/month
# Drives the search_web tool. Leave the key empty and search_web falls back to
# DuckDuckGo Instant Answers then Wikipedia, so Bolo still runs without one.
SERPAPI_API_KEY=

# Hard ceiling on searches per process. A prefetch that misses, plus follow-up
# refinements, all draw from the same budget; cached queries cost nothing.
SERPAPI_CREDIT_CAP=200

# Google locale. India-first, so prices/places/names come back Indian.
SERPAPI_GL=in
SERPAPI_HL=en

# Save every live SerpApi response as a JSON fixture (for offline replay in
# tests and benchmarks, so you never re-spend a credit). Empty = off.
SERPAPI_RECORD_DIR=

# Search while the user is still talking (needs a GPU -- Laya auto-disables on
# CPU). 0 disables the prefetch probe only; everything else keeps working.
BOLO_TOOL_PREFETCH=1
