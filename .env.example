# TASA Configuration
# Copy to .env and adjust values

# LLM (vLLM / OpenAI-compatible API)
TASA_LLM_URL=http://localhost:8000/v1
TASA_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
TASA_LLM_API_KEY=EMPTY

# STT (faster-whisper)
TASA_STT_MODEL=base
TASA_STT_DEVICE=cpu
TASA_STT_COMPUTE=int8

# TTS (Piper)
TASA_TTS_MODEL=/usr/share/piper/voices/en_US-lessac-medium.onnx

# VAD (Silero)
TASA_VAD_THRESHOLD=0.5
