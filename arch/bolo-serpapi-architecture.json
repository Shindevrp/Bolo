  "cards": [
    {
      "dot": "cyan",
      "title": "Why a client, not a call",
      "items": [
        "Hard 5 s timeout — a slow search can never stall a spoken turn",
        "In-flight de-dup under asyncio.shield: a prefetch cancelled at speech-end still lands in the cache instead of wasting the credit",
        "SERPAPI_RECORD_DIR writes every live response as a JSON fixture, so tests and benchmarks never spend a credit"
      ]
    },
    {
      "dot": "emerald",
      "title": "Credit budget",
      "items": [
        "Cap 200 by default (SERPAPI_CREDIT_CAP) against a 250 / month free tier",
        "15 min TTL cache, 5 min negative cache, normalize_query() folds “Goa?” onto “goa”",
        "Fatal account errors (invalid key, ran out of searches) set disabled_reason and fall through to the keyless path"
      ]
    },
    {
      "dot": "violet",
      "title": "Grounding the read-out",
      "items": [
        "condense_google(): answer box → knowledge graph → top 2 organic, each with its source domain",
        "condense_places(): name, rating, price, open state, address — search_places(query, location) has no keyless fallback on purpose",
        "SerpApiError text starts “Search failed:” / “Unable”, so ToolRegistry._result_is_bad retries instead of reading it aloud"
      ]
    }
  ]
